#!/bin/bash
# Reads JSON from stdin, adds session to registry
set -e

REGISTRY="$HOME/.claude/claude-monitor-sessions.json"

input=$(cat)
session_id=$(echo "$input" | jq -r '.session_id // empty')
cwd=$(echo "$input" | jq -r '.cwd // empty')

[[ -z "$session_id" ]] && exit 0

# Get tmux context if available
tmux_session=""
tmux_window=""
tmux_pane_index=""
# Target our own pane explicitly: bare display-message resolves against the
# focused client's pane, which may not be the pane this hook is running in.
if [[ -n "$TMUX" && -n "${TMUX_PANE:-}" ]]; then
  tmux_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true)
  tmux_window=$(tmux display-message -p -t "$TMUX_PANE" '#{window_index}' 2>/dev/null || true)
  tmux_pane_index=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_index}' 2>/dev/null || true)
fi

# Serialise all registry writers on a portable mkdir lock (no flock on macOS);
# atomic write via tmp+mv. Best-effort: proceed after ~5s so hooks never hang.
LOCK="$REGISTRY.lock"
for _ in $(seq 1 50); do
  if mkdir "$LOCK" 2>/dev/null; then
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    break
  fi
  # Reap a stale lock left by a crashed writer (older than 30s). BSD find
  # rejects a fractional -mmin, so compare the mtime in seconds instead.
  lock_mtime=$(stat -f %m "$LOCK" 2>/dev/null || stat -c %Y "$LOCK" 2>/dev/null || echo "")
  if [[ -n "$lock_mtime" ]] && (( $(date +%s) - lock_mtime > 30 )); then
    rmdir "$LOCK" 2>/dev/null || true
  fi
  sleep 0.1
done

# Read existing registry; reset to empty if missing or corrupt.
registry="{}"
[[ -f "$REGISTRY" ]] && registry=$(jq -e . "$REGISTRY" 2>/dev/null) || registry="{}"

# Add/update session entry
registry=$(echo "$registry" | jq \
  --arg sid "$session_id" \
  --arg ts "$tmux_session" \
  --arg tw "$tmux_window" \
  --arg tp "${TMUX_PANE:-}" \
  --arg tpi "$tmux_pane_index" \
  --arg cwd "$cwd" \
  --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '.[$sid] = {tmux_session: $ts, tmux_window: $tw, tmux_pane: $tp, tmux_pane_index: $tpi, cwd: $cwd, started: $started}')

printf '%s\n' "$registry" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
