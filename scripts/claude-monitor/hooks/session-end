#!/bin/bash
# Reads JSON from stdin, removes session from registry
set -e

REGISTRY="$HOME/.claude/claude-monitor-sessions.json"

input=$(cat)
session_id=$(echo "$input" | jq -r '.session_id // empty')

[[ -z "$session_id" || ! -f "$REGISTRY" ]] && exit 0

# Detach the registry write and return at once: SessionEnd runs inside the
# shutdown window and the harness aborts any hook still running when the CLI
# exits ("Hook cancelled"), e.g. a failed --resume that quits immediately.
# session-start's prune is the backstop if this is still lost.
(
# Serialise with the same mkdir lock session-start uses; best-effort ~2s.
LOCK="$REGISTRY.lock"
for _ in $(seq 1 20); do
  if mkdir "$LOCK" 2>/dev/null; then
    trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
    break
  fi
  # Reap a stale lock left by a crashed writer (older than 30s). BSD find
  # rejects a fractional -mmin, so compare the mtime in seconds instead.
  lock_mtime=$(stat -f %m "$LOCK" 2>/dev/null || stat -c %Y "$LOCK" 2>/dev/null || echo "")
  if [[ -n "$lock_mtime" ]] && (( $(date +%s) - lock_mtime > 30 )); then
    rmdir "$LOCK" 2>/dev/null || true
  fi
  sleep 0.1
done

# Tolerate a corrupt registry: skip the delete rather than abort the hook.
jq -e . "$REGISTRY" >/dev/null 2>&1 || exit 0
jq --arg sid "$session_id" 'del(.[$sid])' "$REGISTRY" > "$REGISTRY.tmp" && mv "$REGISTRY.tmp" "$REGISTRY"
) </dev/null >/dev/null 2>&1 &
disown
exit 0
